\@writefile{lof}{\contentsline {figure}{\numberline {40}{\ignorespaces Target GPS estimate accuracy progression through the four-phase detection-to-landing flow. Circle radii are proportional to CEP\textsubscript  {50} at each phase. Tilt compensation in Phase~1 reduces the initial estimate from $\sim $7\,m (uncompensated) to $\sim $3.5\,m. The combination of continuous approach refinement (Phase~2), hover lock with nadir camera (Phase~3), operator verification with GPS averaging (Phase~4), and spatial deduplication of false positives transforms the initial estimate into a $\sim $1.8\,m final position---a $\sim $2$\times $ improvement through operational procedure alone.}}{111}{figure.caption.212}\protected@file@percent }
\newlabel{fig:accuracy-progression}{{40}{111}{Target GPS estimate accuracy progression through the four-phase detection-to-landing flow. Circle radii are proportional to CEP\textsubscript {50} at each phase. Tilt compensation in Phase~1 reduces the initial estimate from $\sim $7\,m (uncompensated) to $\sim $3.5\,m. The combination of continuous approach refinement (Phase~2), hover lock with nadir camera (Phase~3), operator verification with GPS averaging (Phase~4), and spatial deduplication of false positives transforms the initial estimate into a $\sim $1.8\,m final position---a $\sim $2$\times $ improvement through operational procedure alone}{figure.caption.212}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {41}{\ignorespaces CEP$_{50}$ at each phase of the detection-to-landing flow, showing progressive accuracy improvement from $\sim $\SI {3.5}{\metre } (Phase~1, tilt-compensated search) to $\sim $\SI {1.8}{\metre } (Phase~4, GPS-averaged hover lock). Each phase transition eliminates a specific error category: Phase~2 reduces pitch and timing lag as the drone decelerates; Phase~3 drives the pixel offset to zero through centering; Phase~4 averages GPS noise over 50~samples.}}{112}{figure.caption.213}\protected@file@percent }
\newlabel{fig:progressive-accuracy-bars}{{41}{112}{CEP$_{50}$ at each phase of the detection-to-landing flow, showing progressive accuracy improvement from $\sim $\SI {3.5}{\metre } (Phase~1, tilt-compensated search) to $\sim $\SI {1.8}{\metre } (Phase~4, GPS-averaged hover lock). Each phase transition eliminates a specific error category: Phase~2 reduces pitch and timing lag as the drone decelerates; Phase~3 drives the pixel offset to zero through centering; Phase~4 averages GPS noise over 50~samples}{figure.caption.213}{}}
