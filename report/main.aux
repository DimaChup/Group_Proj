\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Geofence protection visualisation. (a)~Five protection layers: Flight Area hard boundary (emergency RTL), SSSI no-fly zone with 30\,m waypoint buffer, 20\,m speed ramp, 3\,m repulsive field, and hard cutoff. (b)~Repulsive force field that deflects the drone away from the SSSI boundary. (c)~Waypoint correction: the commanded waypoint (red) is shifted to a safe position (green) by the repulsive offset. (d)~Emergency mode switch when the drone enters the SSSI zone.}}{24}{figure.caption.26}\protected@file@percent }
\newlabel{fig:geofence_diagram}{{6}{24}{Geofence protection visualisation. (a)~Five protection layers: Flight Area hard boundary (emergency RTL), SSSI no-fly zone with 30\,m waypoint buffer, 20\,m speed ramp, 3\,m repulsive field, and hard cutoff. (b)~Repulsive force field that deflects the drone away from the SSSI boundary. (c)~Waypoint correction: the commanded waypoint (red) is shifted to a safe position (green) by the repulsive offset. (d)~Emergency mode switch when the drone enters the SSSI zone}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Computer vision pipeline: frame capture, lens undistortion, resize to $640\times 640$, TFLite inference, confidence filtering, and coordinate rescaling. The entire pipeline executes in 208\,ms on the Pi~5.}}{24}{figure.caption.30}\protected@file@percent }
