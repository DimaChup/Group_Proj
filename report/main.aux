\@writefile{toc}{\contentsline {paragraph}{Cost of a false positive.}{90}{paragraph*.189}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{False positive mitigation.}{90}{paragraph*.190}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {35}{\ignorespaces Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time.}}{91}{figure.caption.191}\protected@file@percent }
\newlabel{fig:two-step-decision-flow}{{35}{91}{Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time}{figure.caption.191}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {K.19}Cooperative Vision-Flight Architecture}{91}{subsection.K.19}\protected@file@percent }
\newlabel{sec:cooperative-arch}{{K.19}{91}{Cooperative Vision-Flight Architecture}{subsection.K.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {36}{\ignorespaces Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s.}}{91}{figure.caption.192}\protected@file@percent }
\newlabel{fig:cooperative-loop}{{36}{91}{Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s}{figure.caption.192}{}}
