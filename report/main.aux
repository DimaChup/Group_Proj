\@writefile{lof}{\contentsline {figure}{\numberline {53}{\ignorespaces Optimisation variable dependency network. Decision variables (blue) cascade through derived quantities (white) to performance metrics (green/red). Arrow thickness indicates influence strength.}}{145}{figure.caption.239}\protected@file@percent }
\newlabel{fig:optimization-network}{{53}{145}{Optimisation variable dependency network. Decision variables (blue) cascade through derived quantities (white) to performance metrics (green/red). Arrow thickness indicates influence strength}{figure.caption.239}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {54}{\ignorespaces Sensitivity matrix showing the influence of each input parameter on every derived quantity. Darker cells indicate stronger coupling, revealing which measurements most critically affect mission performance.}}{145}{figure.caption.240}\protected@file@percent }
\newlabel{fig:sensitivity-matrix}{{54}{145}{Sensitivity matrix showing the influence of each input parameter on every derived quantity. Darker cells indicate stronger coupling, revealing which measurements most critically affect mission performance}{figure.caption.240}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {55}{\ignorespaces Spider plot of normalised parameter sensitivities. Each axis represents a derived performance metric; the polygon area indicates the overall sensitivity footprint of the design point.}}{146}{figure.caption.241}\protected@file@percent }
\newlabel{fig:sensitivity-spider}{{55}{146}{Spider plot of normalised parameter sensitivities. Each axis represents a derived performance metric; the polygon area indicates the overall sensitivity footprint of the design point}{figure.caption.241}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {56}{\ignorespaces Variable coupling matrix showing pairwise interaction effects. The altitude--speed pair exhibits the only strong coupling, jointly determining coverage rate and detection probability. Off-diagonal cells indicate which performance metric is affected by each variable pair.}}{147}{figure.caption.242}\protected@file@percent }
\newlabel{fig:coupling-matrix}{{56}{147}{Variable coupling matrix showing pairwise interaction effects. The altitude--speed pair exhibits the only strong coupling, jointly determining coverage rate and detection probability. Off-diagonal cells indicate which performance metric is affected by each variable pair}{figure.caption.242}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {57}{\ignorespaces Altitude--speed trade-off space. Colour shows composite mission score (40\% detection $+$ 35\% coverage $+$ 25\% energy). Blue contours: detection probability. Orange contours: coverage time. The selected operating point (35\,m, 8\,m/s) sits above the 95\% detection contour in the high-score region.}}{148}{figure.caption.243}\protected@file@percent }
\newlabel{fig:alt-speed-tradeoff}{{57}{148}{Altitude--speed trade-off space. Colour shows composite mission score (40\% detection $+$ 35\% coverage $+$ 25\% energy). Blue contours: detection probability. Orange contours: coverage time. The selected operating point (35\,m, 8\,m/s) sits above the 95\% detection contour in the high-score region}{figure.caption.243}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {58}{\ignorespaces Function chain diagram tracing the flow from physical inputs (target size, sensor parameters, inference rate) through intermediate quantities (GSD, pixel extent, dwell time) to the five mission performance objectives. Each arrow represents a functional dependency with the governing equation labelled.}}{148}{figure.caption.244}\protected@file@percent }
\newlabel{fig:function-chain}{{58}{148}{Function chain diagram tracing the flow from physical inputs (target size, sensor parameters, inference rate) through intermediate quantities (GSD, pixel extent, dwell time) to the five mission performance objectives. Each arrow represents a functional dependency with the governing equation labelled}{figure.caption.244}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {59}{\ignorespaces Tornado diagram showing the sensitivity of the composite mission score to $\pm $20\% perturbations in each input parameter. Altitude and inference FPS have the largest influence, confirming that the detection--energy trade-off dominates. Parameters are sorted by total bar length (influence magnitude).}}{149}{figure.caption.245}\protected@file@percent }
\newlabel{fig:tornado-sensitivity}{{59}{149}{Tornado diagram showing the sensitivity of the composite mission score to $\pm $20\% perturbations in each input parameter. Altitude and inference FPS have the largest influence, confirming that the detection--energy trade-off dominates. Parameters are sorted by total bar length (influence magnitude)}{figure.caption.245}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {60}{\ignorespaces Target height in the 640$\times $640 model input as a function of altitude. The red dashed line marks the 20\,px detection threshold; the shaded region indicates unreliable detection.}}{149}{figure.caption.248}\protected@file@percent }
\newlabel{fig:alt-vs-px}{{60}{149}{Target height in the 640$\times $640 model input as a function of altitude. The red dashed line marks the 20\,px detection threshold; the shaded region indicates unreliable detection}{figure.caption.248}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {61}{\ignorespaces Motion blur vs.\ drone speed at three altitudes (1/1000\,s exposure, global shutter). The grey dashed line marks the 1\,px visible-blur threshold.}}{150}{figure.caption.250}\protected@file@percent }
\newlabel{fig:speed-blur}{{61}{150}{Motion blur vs.\ drone speed at three altitudes (1/1000\,s exposure, global shutter). The grey dashed line marks the 1\,px visible-blur threshold}{figure.caption.250}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {62}{\ignorespaces Frames the target remains visible vs.\ drone speed at three altitudes (4.8\,FPS). The green and red dashed lines mark the 3-frame smart-detect threshold and 1-frame minimum, respectively.}}{150}{figure.caption.252}\protected@file@percent }
\newlabel{fig:speed-frames}{{62}{150}{Frames the target remains visible vs.\ drone speed at three altitudes (4.8\,FPS). The green and red dashed lines mark the 3-frame smart-detect threshold and 1-frame minimum, respectively}{figure.caption.252}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {63}{\ignorespaces Search efficiency vs.\ altitude. The solid blue line shows coverage rate (m$^2$/s); the dashed pink line shows swath width. Higher altitude improves efficiency at the cost of reduced target pixel size.}}{151}{figure.caption.253}\protected@file@percent }
\newlabel{fig:coverage}{{63}{151}{Search efficiency vs.\ altitude. The solid blue line shows coverage rate (m$^2$/s); the dashed pink line shows swath width. Higher altitude improves efficiency at the cost of reduced target pixel size}{figure.caption.253}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {64}{\ignorespaces Combined detection score across the speed--altitude envelope. Green indicates high-confidence detection; the white contours mark $S = 0.3$, $0.5$, and $0.7$. The operational regime (6--10\,m/s, 20--50\,m) lies entirely within the $S > 0.7$ zone.}}{151}{figure.caption.254}\protected@file@percent }
\newlabel{fig:envelope}{{64}{151}{Combined detection score across the speed--altitude envelope. Green indicates high-confidence detection; the white contours mark $S = 0.3$, $0.5$, and $0.7$. The operational regime (6--10\,m/s, 20--50\,m) lies entirely within the $S > 0.7$ zone}{figure.caption.254}{}}
