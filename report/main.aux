\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.21.4}CEP$_{50}$ Comparison}{94}{subsubsection.K.21.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {37}{\ignorespaces CEP$_{50}$ comparison across seven GPS estimation strategies (lower is better). The centering + GPS averaging approach achieves \SI {1.5}{\metre }---a $4.8\times $ improvement over a single flyover estimate. Error bars omitted for clarity; inter-trial variation was $<$\SI {0.3}{\metre } for all strategies except ``single flyover'' ($\pm $\SI {1.1}{\metre }).}}{94}{figure.caption.195}\protected@file@percent }
\newlabel{fig:cep-comparison}{{37}{94}{CEP$_{50}$ comparison across seven GPS estimation strategies (lower is better). The centering + GPS averaging approach achieves \SI {1.5}{\metre }---a $4.8\times $ improvement over a single flyover estimate. Error bars omitted for clarity; inter-trial variation was $<$\SI {0.3}{\metre } for all strategies except ``single flyover'' ($\pm $\SI {1.1}{\metre })}{figure.caption.195}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.21.5}Convergence Behaviour}{94}{subsubsection.K.21.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {38}{\ignorespaces Convergence of position error over time for the three best estimation strategies. All three begin with the same initial flyover estimate ($\sim $\SI {7}{\metre }). Visual centering converges rapidly to \SI {2.1}{\metre } (GPS noise floor for single fixes) by $t = 15$\,s. GPS averaging during the subsequent 10\,s hold reduces the error further to \SI {1.5}{\metre }. IVW converges more slowly because it relies on accumulating many flyover observations rather than actively centering.}}{94}{figure.caption.196}\protected@file@percent }
\newlabel{fig:convergence-plot}{{38}{94}{Convergence of position error over time for the three best estimation strategies. All three begin with the same initial flyover estimate ($\sim $\SI {7}{\metre }). Visual centering converges rapidly to \SI {2.1}{\metre } (GPS noise floor for single fixes) by $t = 15$\,s. GPS averaging during the subsequent 10\,s hold reduces the error further to \SI {1.5}{\metre }. IVW converges more slowly because it relies on accumulating many flyover observations rather than actively centering}{figure.caption.196}{}}
