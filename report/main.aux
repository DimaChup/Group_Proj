\@writefile{toc}{\contentsline {paragraph}{Cost of a false positive.}{115}{paragraph*.216}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{False positive mitigation.}{115}{paragraph*.217}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time.}}{115}{figure.caption.218}\protected@file@percent }
\newlabel{fig:two-step-decision-flow}{{43}{115}{Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time}{figure.caption.218}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {K.19}Cooperative Vision-Flight Architecture}{115}{subsection.K.19}\protected@file@percent }
\newlabel{sec:cooperative-arch}{{K.19}{115}{Cooperative Vision-Flight Architecture}{subsection.K.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s.}}{116}{figure.caption.219}\protected@file@percent }
\newlabel{fig:cooperative-loop}{{44}{116}{Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s}{figure.caption.219}{}}
