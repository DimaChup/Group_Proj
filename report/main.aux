\@writefile{toc}{\contentsline {subsection}{\numberline {K.17}Detailed Per-State Accuracy Analysis}{102}{subsection.K.17}\protected@file@percent }
\newlabel{sec:detailed-accuracy}{{K.17}{102}{Detailed Per-State Accuracy Analysis}{subsection.K.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {40}{\ignorespaces Target GPS estimate accuracy progression through the four-phase detection-to-landing flow. Circle radii are proportional to CEP\textsubscript  {50} at each phase. Tilt compensation in Phase~1 reduces the initial estimate from $\sim $7\,m (uncompensated) to $\sim $3.5\,m. The combination of continuous approach refinement (Phase~2), hover lock with nadir camera (Phase~3), operator verification with GPS averaging (Phase~4), and spatial deduplication of false positives transforms the initial estimate into a $\sim $1.8\,m final position---a $\sim $2$\times $ improvement through operational procedure alone.}}{103}{figure.caption.213}\protected@file@percent }
\newlabel{fig:accuracy-progression}{{40}{103}{Target GPS estimate accuracy progression through the four-phase detection-to-landing flow. Circle radii are proportional to CEP\textsubscript {50} at each phase. Tilt compensation in Phase~1 reduces the initial estimate from $\sim $7\,m (uncompensated) to $\sim $3.5\,m. The combination of continuous approach refinement (Phase~2), hover lock with nadir camera (Phase~3), operator verification with GPS averaging (Phase~4), and spatial deduplication of false positives transforms the initial estimate into a $\sim $1.8\,m final position---a $\sim $2$\times $ improvement through operational procedure alone}{figure.caption.213}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {41}{\ignorespaces CEP$_{50}$ at each phase of the detection-to-landing flow, showing progressive accuracy improvement from $\sim $\SI {3.5}{\metre } (Phase~1, tilt-compensated search) to $\sim $\SI {1.8}{\metre } (Phase~4, GPS-averaged hover lock). Each phase transition eliminates a specific error category: Phase~2 reduces pitch and timing lag as the drone decelerates; Phase~3 drives the pixel offset to zero through centering; Phase~4 averages GPS noise over 50~samples.}}{104}{figure.caption.214}\protected@file@percent }
\newlabel{fig:progressive-accuracy-bars}{{41}{104}{CEP$_{50}$ at each phase of the detection-to-landing flow, showing progressive accuracy improvement from $\sim $\SI {3.5}{\metre } (Phase~1, tilt-compensated search) to $\sim $\SI {1.8}{\metre } (Phase~4, GPS-averaged hover lock). Each phase transition eliminates a specific error category: Phase~2 reduces pitch and timing lag as the drone decelerates; Phase~3 drives the pixel offset to zero through centering; Phase~4 averages GPS noise over 50~samples}{figure.caption.214}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {K.18}Four-Phase Detection-to-Landing Flow}{104}{subsection.K.18}\protected@file@percent }
\newlabel{sec:two-step}{{K.18}{104}{Four-Phase Detection-to-Landing Flow}{subsection.K.18}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.1}Phase~1: Initial Detection During Search (Tilted Camera)}{104}{subsubsection.K.18.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.2}Phase~2: Approach and Continuous Refinement}{104}{subsubsection.K.18.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.3}Phase~3: Hover Lock (Nadir Confirmation)}{105}{subsubsection.K.18.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.4}Phase~4: Operator Verification and Landing Decision}{105}{subsubsection.K.18.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.5}Why Four Phases Are Necessary}{105}{subsubsection.K.18.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.6}The Progressive Refinement Trajectory}{105}{subsubsection.K.18.6}\protected@file@percent }
\newlabel{sec:creep-up}{{K.18.6}{105}{The Progressive Refinement Trajectory}{subsubsection.K.18.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {42}{\ignorespaces The four-phase progressive refinement trajectory. Phase~1: initial detection at full search speed with tilted camera and tilt-compensated GPS estimate (CEP $\approx $ 3.5\,m). Phase~2: continuous approach and deceleration, pitch decreases, estimate improves (CEP $\approx $ 2.5\,m). Phase~3: stationary hover with nadir camera, all geometric errors eliminated (CEP $\approx $ 1.8\,m); if no target is visible, a 15\,s timeout triggers resumption (red dashed branch). Phase~4: operator confirms via ground station; Y triggers offset landing, N resumes search. Error circles are drawn proportional to CEP at each phase.}}{106}{figure.caption.216}\protected@file@percent }
\newlabel{fig:creep-up}{{42}{106}{The four-phase progressive refinement trajectory. Phase~1: initial detection at full search speed with tilted camera and tilt-compensated GPS estimate (CEP $\approx $ 3.5\,m). Phase~2: continuous approach and deceleration, pitch decreases, estimate improves (CEP $\approx $ 2.5\,m). Phase~3: stationary hover with nadir camera, all geometric errors eliminated (CEP $\approx $ 1.8\,m); if no target is visible, a 15\,s timeout triggers resumption (red dashed branch). Phase~4: operator confirms via ground station; Y triggers offset landing, N resumes search. Error circles are drawn proportional to CEP at each phase}{figure.caption.216}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.7}Design Insight}{106}{subsubsection.K.18.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.8}False Positive Handling}{106}{subsubsection.K.18.8}\protected@file@percent }
\newlabel{sec:false-positive-handling}{{K.18.8}{106}{False Positive Handling}{subsubsection.K.18.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Cost of a false positive.}{107}{paragraph*.217}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{False positive mitigation.}{107}{paragraph*.218}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {43}{\ignorespaces Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time.}}{107}{figure.caption.219}\protected@file@percent }
\newlabel{fig:two-step-decision-flow}{{43}{107}{Complete four-phase decision flow including false positive recovery. The left branch shows successful progression: Phase~1 detection $\to $ Phase~2 approach $\to $ Phase~3 hover lock $\to $ Phase~4 operator verification $\to $ offset landing. The right branch shows the false positive path: no re-detection during Phase~3 hover triggers a \SI {15}{\second } timeout, the location is added to the rejected-targets list (spatial deduplication prevents reinvestigation), and the drone resumes the search pattern at a cost of $<$1\% of mission time}{figure.caption.219}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {K.19}Cooperative Vision-Flight Architecture}{107}{subsection.K.19}\protected@file@percent }
\newlabel{sec:cooperative-arch}{{K.19}{107}{Cooperative Vision-Flight Architecture}{subsection.K.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {44}{\ignorespaces Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s.}}{108}{figure.caption.220}\protected@file@percent }
\newlabel{fig:cooperative-loop}{{44}{108}{Cooperative vision-flight feedback loop. Detection produces a pixel coordinate, GPS estimation projects it to the ground, and flight control steers the drone toward the target. Crucially, flying closer improves the next detection: lower altitude yields finer GSD, deceleration reduces pitch-induced tilt error, and hovering at nadir drives the pixel offset---and therefore all multiplicative projection errors---toward zero. The cycle repeats until convergence, typically within 15--20\,s}{figure.caption.220}{}}
