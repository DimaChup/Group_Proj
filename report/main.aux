\@writefile{lof}{\contentsline {figure}{\numberline {91}{\ignorespaces CEP$_{50}$ comparison of four fusion algorithms on DJI replay data. IVW (inverse-variance weighting) achieves the lowest error at 2.3\,m, highlighted as the selected method. Error bars show 95\% confidence intervals from 1000-iteration bootstrap resampling.}}{237}{figure.caption.529}\protected@file@percent }
\newlabel{fig:estimator-comparison}{{91}{237}{CEP$_{50}$ comparison of four fusion algorithms on DJI replay data. IVW (inverse-variance weighting) achieves the lowest error at 2.3\,m, highlighted as the selected method. Error bars show 95\% confidence intervals from 1000-iteration bootstrap resampling}{figure.caption.529}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {92}{\ignorespaces Convergence of the IVW GPS estimate during a single flyover at 5\,m/s and 35\,m altitude. The estimate stabilises after $\sim $5 detections, with diminishing returns beyond 10. The dashed line indicates the GPS averaging floor ($\sim $1.0\,m CEP).}}{237}{figure.caption.530}\protected@file@percent }
\newlabel{fig:gps-convergence}{{92}{237}{Convergence of the IVW GPS estimate during a single flyover at 5\,m/s and 35\,m altitude. The estimate stabilises after $\sim $5 detections, with diminishing returns beyond 10. The dashed line indicates the GPS averaging floor ($\sim $1.0\,m CEP)}{figure.caption.530}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {93}{\ignorespaces Position error vs.\ time for three estimation strategies. Visual centering converges to $\sim $2.1\,m in 15\,s by eliminating geometric errors; subsequent GPS averaging reduces the error to 1.5\,m. IVW passive converges more slowly ($\sim $60\,s for comparable accuracy) because it relies on statistical averaging of flyover observations without active geometric correction.}}{237}{figure.caption.531}\protected@file@percent }
\newlabel{fig:convergence-plot-eval}{{93}{237}{Position error vs.\ time for three estimation strategies. Visual centering converges to $\sim $2.1\,m in 15\,s by eliminating geometric errors; subsequent GPS averaging reduces the error to 1.5\,m. IVW passive converges more slowly ($\sim $60\,s for comparable accuracy) because it relies on statistical averaging of flyover observations without active geometric correction}{figure.caption.531}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {AG.6}Directional Error Analysis}{237}{subsection.Alph33.6}\protected@file@percent }
\newlabel{sec:directional-error}{{AG.6}{237}{Directional Error Analysis}{subsection.Alph33.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {94}{\ignorespaces Directional GPS estimation error from DJI replay. The along-track (N--S) error is $\sim $1.4$\times $ the cross-track (E--W) error, consistent with GPS timing lag and residual pitch compensation error during predominantly North--South flight legs.}}{238}{figure.caption.532}\protected@file@percent }
\newlabel{fig:gps-error-direction}{{94}{238}{Directional GPS estimation error from DJI replay. The along-track (N--S) error is $\sim $1.4$\times $ the cross-track (E--W) error, consistent with GPS timing lag and residual pitch compensation error during predominantly North--South flight legs}{figure.caption.532}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {95}{\ignorespaces Along-track estimation bias as a function of flight heading from DJI replay data. The sinusoidal pattern (amplitude $\sim $0.7\,m) is consistent with GPS timing lag of $\sim $140\,ms at 5\,m/s. Passes on reciprocal headings (e.g., 0\ensuremath  {^\circ }{} and 180\ensuremath  {^\circ }{}) produce biases of opposite sign, confirming that multi-pass averaging from alternating headings cancels this systematic error.}}{238}{figure.caption.533}\protected@file@percent }
\newlabel{fig:heading-bias}{{95}{238}{Along-track estimation bias as a function of flight heading from DJI replay data. The sinusoidal pattern (amplitude $\sim $0.7\,m) is consistent with GPS timing lag of $\sim $140\,ms at 5\,m/s. Passes on reciprocal headings (e.g., 0\degree {} and 180\degree {}) produce biases of opposite sign, confirming that multi-pass averaging from alternating headings cancels this systematic error}{figure.caption.533}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {AG.7}Operational Recommendations}{238}{subsection.Alph33.7}\protected@file@percent }
\newlabel{sec:eval-recommendations}{{AG.7}{238}{Operational Recommendations}{subsection.Alph33.7}{}}
