\newlabel{sec:creep-up}{{K.18.6}{89}{The Progressive Refinement Trajectory}{subsubsection.K.18.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {34}{\ignorespaces The four-phase progressive refinement trajectory. Phase~1: initial detection at full search speed with tilted camera and tilt-compensated GPS estimate (CEP $\approx $ 3.5\,m). Phase~2: continuous approach and deceleration, pitch decreases, estimate improves (CEP $\approx $ 2.5\,m). Phase~3: stationary hover with nadir camera, all geometric errors eliminated (CEP $\approx $ 1.8\,m); if no target is visible, a 15\,s timeout triggers resumption (red dashed branch). Phase~4: operator confirms via ground station; Y triggers offset landing, N resumes search. Error circles are drawn proportional to CEP at each phase.}}{89}{figure.caption.188}\protected@file@percent }
\newlabel{fig:creep-up}{{34}{89}{The four-phase progressive refinement trajectory. Phase~1: initial detection at full search speed with tilted camera and tilt-compensated GPS estimate (CEP $\approx $ 3.5\,m). Phase~2: continuous approach and deceleration, pitch decreases, estimate improves (CEP $\approx $ 2.5\,m). Phase~3: stationary hover with nadir camera, all geometric errors eliminated (CEP $\approx $ 1.8\,m); if no target is visible, a 15\,s timeout triggers resumption (red dashed branch). Phase~4: operator confirms via ground station; Y triggers offset landing, N resumes search. Error circles are drawn proportional to CEP at each phase}{figure.caption.188}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {K.18.7}Design Insight}{90}{subsubsection.K.18.7}\protected@file@percent }
