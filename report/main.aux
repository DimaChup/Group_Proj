\@writefile{lot}{\contentsline {table}{\numberline {160}{\ignorespaces Error budget for single-frame GPS estimation at 35\,m altitude. Contribution percentages are derived from variance propagation through the pixel-to-GPS projection (Section~\ref {sec:error-budget}) and validated against the DJI replay scatter distribution. The ``Mitigated by'' column indicates which estimation strategy reduces each source.}}{235}{table.caption.523}\protected@file@percent }
\newlabel{tab:error-budget-relative}{{160}{235}{Error budget for single-frame GPS estimation at 35\,m altitude. Contribution percentages are derived from variance propagation through the pixel-to-GPS projection (Section~\ref {sec:error-budget}) and validated against the DJI replay scatter distribution. The ``Mitigated by'' column indicates which estimation strategy reduces each source}{table.caption.523}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {88}{\ignorespaces Waterfall chart showing the cumulative contribution of each error source to the total single-frame CEP. GPS receiver noise dominates ($\sim $65\% of variance), confirming that multi-frame averaging---which targets random noise---is the most effective single improvement. Attitude compensation eliminates the second-largest contributor.}}{235}{figure.caption.524}\protected@file@percent }
\newlabel{fig:error-waterfall}{{88}{235}{Waterfall chart showing the cumulative contribution of each error source to the total single-frame CEP. GPS receiver noise dominates ($\sim $65\% of variance), confirming that multi-frame averaging---which targets random noise---is the most effective single improvement. Attitude compensation eliminates the second-largest contributor}{figure.caption.524}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {89}{\ignorespaces Error budget breakdown showing the relative contribution of each error source at 20\,m, 35\,m, and 50\,m altitude. GPS receiver noise (blue) dominates at all altitudes. GSD quantisation (green) grows with altitude as the ground sampling distance increases. Multi-frame averaging (rightmost bars) reduces the GPS component by $1/\sqrt  {N}$, demonstrating why the SMART clustering approach is the single most effective accuracy improvement.}}{235}{figure.caption.525}\protected@file@percent }
\newlabel{fig:error-budget-breakdown}{{89}{235}{Error budget breakdown showing the relative contribution of each error source at 20\,m, 35\,m, and 50\,m altitude. GPS receiver noise (blue) dominates at all altitudes. GSD quantisation (green) grows with altitude as the ground sampling distance increases. Multi-frame averaging (rightmost bars) reduces the GPS component by $1/\sqrt {N}$, demonstrating why the SMART clustering approach is the single most effective accuracy improvement}{figure.caption.525}{}}
\@writefile{toc}{\contentsline {paragraph}{Interpretation.}{235}{paragraph*.526}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {90}{\ignorespaces Centrality weighting heatmap across the camera image plane. Detections at the optical centre receive weight $w_\mathrm  {cen} = 5.0$; detections at the image corners receive $w_\mathrm  {cen} = 1.0$. Combined with the altitude weight $w_\mathrm  {alt} = (h_\mathrm  {ref}/h)^2$, a near-centre detection at 15\,m altitude receives $20\times $ the weight of a corner detection at 35\,m, ensuring that the fused estimate is dominated by the geometrically most reliable observations.}}{236}{figure.caption.527}\protected@file@percent }
\newlabel{fig:centrality-weighting}{{90}{236}{Centrality weighting heatmap across the camera image plane. Detections at the optical centre receive weight $w_\mathrm {cen} = 5.0$; detections at the image corners receive $w_\mathrm {cen} = 1.0$. Combined with the altitude weight $w_\mathrm {alt} = (h_\mathrm {ref}/h)^2$, a near-centre detection at 15\,m altitude receives $20\times $ the weight of a corner detection at 35\,m, ensuring that the fused estimate is dominated by the geometrically most reliable observations}{figure.caption.527}{}}
