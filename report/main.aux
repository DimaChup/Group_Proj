\@writefile{toc}{\contentsline {paragraph}{Geofence enforcement.}{18}{paragraph*.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Geofence protection visualisation. (a)~Five protection layers: Flight Area hard boundary (emergency RTL), SSSI no-fly zone with 30\,m waypoint buffer, 8\,m speed ramp, 3\,m repulsive field, and hard cutoff. (b)~Repulsive force field that deflects the drone away from the SSSI boundary. (c)~Waypoint correction: the commanded waypoint (red) is shifted to a safe position (green) by the repulsive offset. (d)~Emergency mode switch when the drone enters the SSSI zone.}}{19}{figure.caption.33}\protected@file@percent }
\newlabel{fig:geofence_diagram}{{7}{19}{Geofence protection visualisation. (a)~Five protection layers: Flight Area hard boundary (emergency RTL), SSSI no-fly zone with 30\,m waypoint buffer, 8\,m speed ramp, 3\,m repulsive field, and hard cutoff. (b)~Repulsive force field that deflects the drone away from the SSSI boundary. (c)~Waypoint correction: the commanded waypoint (red) is shifted to a safe position (green) by the repulsive offset. (d)~Emergency mode switch when the drone enters the SSSI zone}{figure.caption.33}{}}
