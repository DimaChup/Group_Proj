\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Spider plot of normalised sensitivities. Polygon area indicates the overall sensitivity footprint. A compact polygon means the design is robust to perturbations.}}{7}{figure.caption.16}\protected@file@percent }
