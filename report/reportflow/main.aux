\@writefile{toc}{\contentsline {paragraph}{1. Start from detection: how high can we fly and still see the target?}{3}{paragraph*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. Add a safety margin.}{3}{paragraph*.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{3. At 35\,m, how fast can we fly?}{3}{paragraph*.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Altitude--speed trade-off space. Colour encodes the composite score (40\% detection $+$ 35\% coverage $+$ 25\% energy). Blue contours: detection probability. Orange contours: coverage time. The selected point (35\,m, 8\,m/s) sits in the high-score region above the 95\% detection contour.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:alt-speed-body}{{3}{4}{Altitude--speed trade-off space. Colour encodes the composite score (40\% detection $+$ 35\% coverage $+$ 25\% energy). Blue contours: detection probability. Orange contours: coverage time. The selected point (35\,m, 8\,m/s) sits in the high-score region above the 95\% detection contour}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {paragraph}{4. What scan angle minimises energy?}{4}{paragraph*.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Energy heatmap across 216 altitude--angle configurations. A clear low-energy valley runs through 65--75\textdegree {} at all altitudes, corresponding to longest-edge alignment. The red star marks the global energy minimum (50\,m, 70\textdegree ). The selected point (35\,m, 70\textdegree ) trades 4.4\,Wh of energy for a 44\% increase in target pixel extent.}}{5}{figure.caption.9}\protected@file@percent }
\newlabel{fig:energy-heatmap}{{4}{5}{Energy heatmap across 216 altitude--angle configurations. A clear low-energy valley runs through 65--75\textdegree {} at all altitudes, corresponding to longest-edge alignment. The red star marks the global energy minimum (50\,m, 70\textdegree ). The selected point (35\,m, 70\textdegree ) trades 4.4\,Wh of energy for a 44\% increase in target pixel extent}{figure.caption.9}{}}
